{
  "functions": {
    "api/proxy/[...path].ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/proxy/(.*)",
      "dest": "/api/proxy/[...path]"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "^/[^.]+$",
      "dest": "/index.html"
    }
  ]
}
